  "knowledges": [
    {
      "id": "lcn_95cf393406c2a5bb",
      "type": "claim",
      "content": "物体下落速度与其重量成正比：重物比轻物下落更快",
      "metadata": {
        "schema": "literature",
        "source": "Aristotle, De Caelo I.6"
      }
    },
    {
      "id": "lcn_d2825ea814f3dc68",
      "type": "claim",
      "content": "在真空（无阻力）环境中，不同重量的物体以相同速率下落",
      "metadata": {
        "schema": "derivation",
        "source": "Galileo, Discorsi 1638"
      }
    },
    {
      "id": "lcn_34d1ee01b6b33744",
      "type": "claim",
      "content": "不同重量物体的下落速度差异由介质阻力决定——阻力越大差异越大，阻力越小差异越小",
      "metadata": {
        "schema": "derivation",
        "source": "Galileo, Discorsi (abduction)"
      }
    },
    {
      "id": "lcn_db93e500a0850e67",
      "type": "claim",
      "content": "日常生活中，石头比羽毛下落更快，铁球比木球更快",
      "metadata": {
        "schema": "observation"
      }
    },
    {
      "id": "lcn_302d9c852755aa5b",
      "type": "claim",
      "content": "在不同介质中比较轻重物体的下落，介质越稠密速度差异越明显；越稀薄差异越不明显",
      "metadata": {
        "source": "Galileo, Discorsi"
      }
    },
    {
      "id": "lcn_90c9007df6469808",
      "type": "claim",
      "content": "在空气中，金球、铅球、铜球等重材料球从100腕尺落下，金球领先铜球不超过四指",
      "metadata": {
        "source": "Galileo, Discorsi"
      }
    },
    {
      "id": "lcn_9429ca17d9571031",
      "type": "claim",
      "content": "在斜面倾角θ₁下，不同重量的光滑球滚下，距离之比等于时间之比的平方，与球重量无关"
    },
    {
      "id": "lcn_55760b28535eea32",
      "type": "claim",
      "content": "在斜面倾角θ₂下，不同重量的光滑球滚下，距离之比等于时间之比的平方，与球重量无关"
    },
    {
      "id": "lcn_5f4c0ac3b0a195b5",
      "type": "setting",
      "content": "真空是完全没有阻力的介质（介质密度为零）"
    },
    {
      "id": "lcn_8101eea5d84bcf8a",
      "type": "setting",
      "content": "斜面沟槽经抛光处理，衬以羊皮纸，使用坚硬光滑的青铜球——摩擦和空气阻力可忽略"
    },
    {
      "id": "lcn_d02568002aa09f98",
      "type": "claim",
      "content": "假设重物下落更快，将重球H与轻球L绑在一起，L拖拽H，复合体HL速度应慢于H单独下落"
    },
    {
      "id": "lcn_526be6f1f7bc49b6",
      "type": "claim",
      "content": "假设重物下落更快，复合体HL总重量大于H，因此HL速度应快于H单独下落"
    },
    {
      "id": "lcn_caf64b4b411f6c5f",
      "type": "claim",
      "content": "在真空中也应重者更快（将A的普遍规律应用于真空的推论）"
    },
    {
      "id": "lcn_09dd3f8546de5051",
      "type": "claim",
      "content": "若A成立，则日常中重物应比轻物下落更快（A的可观测预测）"
    },
    {
      "id": "lcn_159c6e9e2183cc2a",
      "type": "claim",
      "content": "若G成立，则稠密介质中轻重物体速度差异应更大（G的可观测预测）"
    },
    {
      "id": "lcn_25547afe4640f9ec",
      "type": "claim",
      "content": "若G成立，则空气中轻重物体速度差异应极小（G的可观测预测）"
    },
    {
      "id": "lcn_ec854454a7be9bd1",
      "type": "claim",
      "content": "若V+S_plane成立，则倾角θ₁下s∝t²应与球重量无关（V的可观测预测）"
    },
    {
      "id": "lcn_01de2e7302c5ee72",
      "type": "claim",
      "content": "若V+S_plane成立，则倾角θ₂下s∝t²应与球重量无关（V的可观测预测）"
    },
    {
      "id": "lcn_ff7b6028706dd573",
      "type": "claim",
      "content": "G与S_vac的合取成立（阻力决定差异且真空阻力为零）"
    },
    {
      "id": "lcn_cadb9a08ac205d10",
      "type": "claim",
      "content": "V与S_plane的合取成立（真空等速且低摩擦斜面条件满足）——用于推导θ₁预测"
    },
    {
      "id": "lcn_3dd360c97561f979",
      "type": "claim",
      "content": "V与S_plane的合取成立（真空等速且低摩擦斜面条件满足）——用于推导θ₂预测"
    },
    {
      "id": "lcn_648ec760e2421907",
      "type": "claim",
      "content": "A与S_vac的合取成立（A为普遍规律且真空条件满足）"
    }
  ],
