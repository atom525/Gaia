      "representative_lcn": null,
      "type": "claim"
    },
    {
      "content": "在真空中，不同重量的物体应以相同速率下落。",
      "id": "lcn_61b525847b0bfd1e",
      "local_members": null,
      "metadata": {
        "source_refs": [
